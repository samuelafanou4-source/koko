# Copier en .env puis lancer `npm run setup:env` pour générer les secrets.
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Deux bases PostgreSQL séparées (identité / santé).
# Supabase : URL du pooler « Transaction » (port 6543). Koko y ajoute
# automatiquement pgbouncer=true (indispensable avec Prisma).
IDENTITY_DATABASE_URL=""
HEALTH_DATABASE_URL=""

# Migrations uniquement (npm run db:deploy) : connexion directe ou pooler
# « Session » (port 5432). Optionnel : à défaut, les URL ci-dessus sont utilisées.
IDENTITY_DIRECT_URL=""
HEALTH_DIRECT_URL=""

# Générés par `npm run setup:env` (ne jamais les committer)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ENCRYPTION_KEY=""
CRON_SECRET=""

# Optionnel : Assistant Koko (sinon mode secours)
GEMINI_API_KEY=""

# Optionnel : rappels WhatsApp
WHATSAPP_ENABLED="false"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# Déconnexion automatique après N minutes sans activité (défaut : 15, de 1 à 1440)
INACTIVITY_TIMEOUT_MINUTES="15"
