{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate --schema=prisma/identity.prisma && prisma generate --schema=prisma/health.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/identity.prisma --name init && prisma migrate dev --schema=prisma/health.prisma --name init",
    "db:seed": "npx tsx src/scripts/seed.ts",
    "db:reset": "prisma migrate reset --schema=prisma/identity.prisma --force && prisma migrate reset --schema=prisma/health.prisma --force",
    "setup:env": "npx tsx scripts/setup-env.ts",
    "prisma:generate:identity": "prisma generate --schema=prisma/identity.prisma",
    "prisma:generate:health": "prisma generate --schema=prisma/health.prisma",
    "prisma:generate": "npm run prisma:generate:identity && npm run prisma:generate:health",
    "prisma:migrate:identity": "prisma migrate dev --schema=prisma/identity.prisma",
    "prisma:migrate:health": "prisma migrate dev --schema=prisma/health.prisma",
    "prisma:push:identity": "prisma db push --schema=prisma/identity.prisma",
    "prisma:push:health": "prisma db push --schema=prisma/health.prisma",
    "prisma:push": "npm run prisma:push:identity && npm run prisma:push:health",
    "seed": "tsx src/scripts/seed.ts",
    "generate:secrets": "tsx src/scripts/generate-secrets.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^7.0.0",
    "@prisma/client": "^6.19.3",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "argon2": "^0.45.1",
    "autoprefixer": "^10.6.2",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.9.0",
    "jose": "^6.2.14",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.66.0",
    "material-symbols": "^0.48.2",
    "next": "16.4.3",
    "postcss": "^8.5.32",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "rate-limiter-flexible": "^11.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@serwist/next": "^9.5.13",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.19.3",
    "serwist": "^9.5.13",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@types/node": "$@types/node"
  }
}
